<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/root.css" />
    <link rel="stylesheet" href="/message.css" />
    <title>Message</title>
  </head>
  <body>
    <h1><%=msg.title%></h1>
    <h3>— By <em><%= username %></em></h3>
    <p><%=msg.text%></p>
    <p>
      <%=msg.added.toLocaleDateString('en-US', { year: 'numeric', month:
      'short', day: 'numeric'})%>
    </p>
  </body>
</html>
