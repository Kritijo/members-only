<h1>Members-Only</h1>
<p>Login or signup to create and post messages!</p>
<div class="form-bttns">
  <a href="/sign-up">Sign up</a>
  <a href="/log-in">Log in</a>
</div>
<div class="container">
  <ul>
    <a href="/view/<%= messages[0].id %>"
      ><li>
        <strong><%= messages[0].title %></strong>: <%= messages[0].text %>
        <em>
          <%= messages[0].added.toLocaleDateString('en-US', { year: 'numeric',
          month: 'short', day: 'numeric'}) %>
        </em>
        <em><%if(user){%> <%= messages[0].id %><%}%></em>
      </li></a
    >
  </ul>
  <div class="gif">
    <p>Waiting for you to join in.</p>
    <img src="wait.webp" />
  </div>
</div>
